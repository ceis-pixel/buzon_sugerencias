# Keep the build context minimal and free of secrets.

# Secrets and local environment files (never enter image layers)
.env
.env.*
!.env.example

# Dependencies and build output (rebuilt inside the image)
node_modules
.next
out
build
coverage
*.tsbuildinfo

# VCS, CI and editor metadata
.git
.github
.gitattributes
.editorconfig
.vscode
.idea

# Runtime data
uploads

# Not needed to build the application
docker-compose*.yml
Dockerfile
.dockerignore
docker
supabase
tests
docs
*.md
vercel.json
.firebase
.apphosting
npm-debug.log*
