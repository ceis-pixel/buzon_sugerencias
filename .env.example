# Buzón de Sugerencias - Comedor UNSCH · Infraestructura institucional (OTI)
#
# Despliegue con Docker:  cp .env.example .env        (lo lee docker compose)
# Desarrollo en el host:  cp .env.example .env.local  (lo lee next dev)
#
# Reemplaza todos los valores de ejemplo antes de desplegar: la aplicación
# rechaza los secretos de muestra. Ninguno de estos archivos se versiona ni
# entra en la imagen de Docker.

# --- Aplicación ------------------------------------------------------------
NODE_ENV=production
PORT=3000

# --- PostgreSQL 16 (servicio "db") -----------------------------------------
# Solo se aplican la primera vez que se crea el volumen postgres_data.
POSTGRES_DB=buzon_comedor
POSTGRES_USER=unsch_admin
POSTGRES_PASSWORD=cambia_esta_clave
# Debe coincidir con los tres valores anteriores. "db" es el nombre del
# servicio en la red interna de Docker. Si la clave contiene caracteres
# reservados (@ : / ? #), codifícalos en formato URL.
DATABASE_URL=postgresql://unsch_admin:cambia_esta_clave@db:5432/buzon_comedor

# --- Autenticación: NextAuth + Google Workspace SSO institucional ----------
# URL pública del sitio. En Google Cloud Console registra como URI de
# redireccionamiento autorizado:  <NEXTAUTH_URL>/api/auth/callback/google
NEXTAUTH_URL=http://localhost:3000
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=genera_un_hash_aleatorio_32_bytes
GOOGLE_CLIENT_ID=tu_client_id_de_google_workspace
GOOGLE_CLIENT_SECRET=tu_client_secret_de_google_workspace
# Dominio institucional autorizado, sin @, protocolo ni ruta.
ALLOWED_EMAIL_DOMAIN=unsch.edu.pe

# --- Disociación criptográfica (Ley N.º 29733) -----------------------------
# Clave del hash efímero anti-spam. Debe ser distinta de NEXTAUTH_SECRET
# (mínimo 32 caracteres: openssl rand -base64 32). Si la cambias, los cupos
# por turno del día en curso se reinician.
RATE_LIMIT_HMAC_SECRET=genera_otro_hash_seguro_para_disociacion

# --- Almacenamiento local de fotografías -----------------------------------
# Ruta dentro del contenedor (volumen app_uploads). En desarrollo sobre el
# host usa una ruta relativa, por ejemplo ./uploads.
UPLOAD_DIR=/app/uploads

# --- Valores públicos (se incorporan al compilar la interfaz) ---------------
# URL pública de la aplicación; configura el dominio real al desplegar.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=unsch.edu.pe
