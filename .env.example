# Copia este archivo a .env.local y reemplaza los ejemplos antes de desplegar.
# Los placeholders permiten compilar en CI; no autentican contra Supabase.

# Supabase: URL HTTP/HTTPS y clave pública anon (mínimo 12 caracteres).
# Usa únicamente la clave anon o publishable; nunca una clave service_role.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Exclusiva del servidor; obligatoria solo para operaciones privilegiadas.
# Mínimo 20 caracteres. Nunca agregues el prefijo NEXT_PUBLIC_ a esta clave.
# Puede omitirse al compilar la interfaz o ejecutar las pruebas en CI.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-client

# URL pública de la aplicación; configura el dominio HTTPS real al desplegar.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dominio estudiantil sin @, protocolo ni ruta. No reemplaza la autorización.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=unsch.edu.pe
