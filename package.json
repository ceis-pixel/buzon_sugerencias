{
  "name": "unsch-dining-feedback",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate-env",
    "build": "next build",
    "start": "next start",
    "analyze": "tsx scripts/analyze.ts",
    "lint": "eslint . --max-warnings=0",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "validate-env": "tsx scripts/validate-env.ts",
    "test": "vitest run",
    "check-all": "npm run typecheck && npm run lint && npm run build",
    "check": "npm run test && npm run check-all",
    "maintenance": "tsx --conditions=react-server scripts/nightly-cleanup.ts",
    "build:maintenance": "esbuild scripts/nightly-cleanup.ts --bundle --platform=node --target=node24 --conditions=react-server --external:pg-native --log-level=warning --outfile=.next/standalone/maintenance/nightly-cleanup.cjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "next-auth": "4.24.15",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "server-only": "0.0.1",
    "xlsx": "^0.18.5",
    "zod": "4.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@next/bundle-analyzer": "^16.3.6",
    "@next/env": "16.3.4",
    "@types/node": "22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "10.5.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "5.0.0"
  }
}
